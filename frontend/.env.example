# Django API (server-side fetch from Next.js)
BTS_API_URL=http://127.0.0.1:8000
# ISR revalidate interval for API-backed pages (seconds)
BTS_API_REVALIDATE=300

# Canonical domain for sitemap, OG, JSON-LD (default: https://bullettrainstation.com)
# NEXT_PUBLIC_SITE_URL=https://bullettrainstation.com

# Google Search Console HTML tag verification (optional; you may already use DNS)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=